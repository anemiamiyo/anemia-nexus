{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@fixture/ui": ["packages/ui/src/index.ts"],
      "@fixture/ui/*": ["packages/ui/src/*"],
      "@fixture/private-lib": ["packages/private-lib/src/index.ts"]
    }
  },
  "include": ["src", "packages/*/src"]
}
