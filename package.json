{
  "name": "anemia-nexus-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Anemia Nexus — deterministic index-based change audit and API governance workspace",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w anemia-core && npm run build -w anemia-mcp && npm run build -w anemia-cli && npm run build -w anemia-adapter-vue",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "phase00": "node phase00/run-all.mjs",
    "perf": "node tools/perf/run.mjs --loc 10000 --repetitions 3",
    "gate:incremental": "vitest run packages/core/test/incremental.test.ts packages/core/test/recovery.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@sourcegraph/scip-typescript": "0.4.0",
    "@types/node": "22.20.5",
    "@vue/compiler-sfc": "3.5.45",
    "@vue/language-core": "3.3.14",
    "eslint": "10.14.0",
    "eslint-plugin-n": "18.5.0",
    "prettier": "3.10.0",
    "proper-lockfile": "4.1.2",
    "ts-morph": "28.0.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14",
    "zod": "4.6.7"
  }
}
