{
  "name": "anemia-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Anemia Nexus (8 tools, stdio)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "anemia-core": "0.0.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
