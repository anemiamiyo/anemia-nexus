{
  "name": "anemia-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Command-line interface for Anemia Nexus (workspace skeleton)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "bin": {
    "nex": "./dist/main.js",
    "anex": "./dist/main.js",
    "anemia": "./dist/main.js"
  },
  "dependencies": {
    "anemia-core": "0.0.0",
    "anemia-mcp": "0.0.0",
    "commander": "15.1.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ../../tsconfig.typecheck.json"
  }
}
