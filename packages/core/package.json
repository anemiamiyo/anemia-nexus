{
  "name": "anemia-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Core indexing, storage, and query engine for Anemia Nexus (workspace skeleton)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "@sourcegraph/scip-typescript": "0.4.0",
    "@vue/compiler-dom": "3.5.45",
    "@vue/compiler-sfc": "3.5.45",
    "@vue/language-core": "3.3.14",
    "proper-lockfile": "4.1.2",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ../../tsconfig.typecheck.json"
  }
}
